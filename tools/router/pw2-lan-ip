#!/bin/sh
# pw2-lan-ip - сменить адрес роутера в локальной сети (LAN) с безопасным откатом.
#   pw2-lan-ip status                  текущий адрес и диапазон DHCP
#   pw2-lan-ip set 10.99.77.1          новый адрес (маска /24); DHCP-диапазон остаётся .100-.249 новой сети
#   pw2-lan-ip set 10.99.77.1 --now    без таймера отката (если уверены)
#   pw2-lan-ip keep                    подтвердить новый адрес (отменяет откат)
# Зачем откат: после смены адреса ваш компьютер остаётся в старой сети и роутер пропадает из виду. Скрипт ждёт 3 минуты подтверждения (pw2-lan-ip keep по новому адресу):
# не подтвердили - старый адрес возвращается сам. Порядок: 1) set; 2) на компьютере обновить адрес (отключить/подключить кабель или Wi-Fi, ipconfig /renew);
# 3) ssh root@НОВЫЙ_АДРЕС; 4) pw2-lan-ip keep.
# Используется, чтобы NX31 (по умолчанию 192.168.1.1) получил адрес продукта 10.99.77.1, как у виртуального роутера.
C=network; MARK=/tmp/pw2-lan-ip.keep; BK=/tmp/pw2-lan-ip.backup; WAIT=180
cur() { uci -q get $C.lan.ipaddr; }
case "$1" in
  status|"")
    echo "LAN: $(cur)/$(uci -q get $C.lan.netmask)   DHCP: .$(uci -q get dhcp.lan.start) - .$(( $(uci -q get dhcp.lan.start) + $(uci -q get dhcp.lan.limit) - 1 ))"
    [ -f $BK ] && [ ! -f $MARK ] && echo "ВНИМАНИЕ: идёт откат на $(cat $BK): подтвердите командой pw2-lan-ip keep по НОВОМУ адресу"
    ;;
  set)
    NEW=$2; MODE=$3
    echo "$NEW" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || { echo "использование: pw2-lan-ip set 10.99.77.1 [--now]"; exit 1; }
    case "$NEW" in *.0|*.255) echo "адрес роутера не может оканчиваться на .0 или .255"; exit 1;; esac
    OLD=$(cur); [ "$OLD" = "$NEW" ] && { echo "адрес уже $NEW"; exit 0; }
    [ "$(uci -q get $C.wan.proto)" = "static" ] && [ "$(uci -q get $C.wan.ipaddr | cut -d. -f1-3)" = "$(echo $NEW | cut -d. -f1-3)" ] && { echo "ОШИБКА: подсеть $NEW совпадает с подсетью WAN ($(uci -q get $C.wan.ipaddr))"; exit 1; }
    echo "$OLD" > $BK; rm -f $MARK
    uci set $C.lan.ipaddr="$NEW"; uci set $C.lan.netmask=255.255.255.0; uci commit $C
    if [ "$MODE" != "--now" ]; then
      ( sleep $WAIT; if [ ! -f $MARK ]; then uci set $C.lan.ipaddr="$OLD"; uci commit $C; /etc/init.d/network restart; logger -t pw2-lan-ip "нет подтверждения - возвращён адрес $OLD"; fi ) >/dev/null 2>&1 &
      echo "Новый адрес $NEW применяется через 3 с. Дальше: обновите адрес на компьютере, зайдите ssh root@$NEW и выполните: pw2-lan-ip keep  (в течение 3 минут, иначе вернётся $OLD)"
    else
      echo "Новый адрес $NEW применяется через 3 с (без отката). Старый был $OLD."
      touch $MARK
    fi
    ( sleep 3; /etc/init.d/network restart; /etc/init.d/dnsmasq restart ) >/dev/null 2>&1 &
    ;;
  keep)
    touch $MARK; echo "Адрес $(cur) подтверждён, откат отменён."
    ;;
  *) echo "использование: pw2-lan-ip status | set АДРЕС [--now] | keep"; exit 1 ;;
esac
