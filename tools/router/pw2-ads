#!/bin/sh
# pw2-ads - блокировка рекламы и трекеров (по доменам, в Xray).
#   pw2-ads status   - включена ли блокировка, сколько доменов
#   pw2-ads on       - включить (ADS_BLOCK=1)
#   pw2-ads off      - выключить (ADS_BLOCK=0)
#   pw2-ads update   - скачать свежие базы ADS-GLOBAL/ADS-RU из релиза репозитория OpenWRT-VM-PROXY-ads (адрес: ADS_UPDATE_URL в /etc/pw2-routing.conf), проверить SHA256 и подключить
#   pw2-ads allow D  - добавить домен D в исключения (разблокировать: убрать из ADS_DOMAINS, а если его блокирует geosite - создать правило-исключение не получится, тогда отключите блокировку для сайта командой "pw2-ads off")
# Списки: ADS_GEOSITE (готовый список geosite:category-ads-all) и ADS_DOMAINS (свои домены) в /etc/pw2-routing.conf.
# Блок работает только для трафика, проходящего через Xray (прокси 1080/1081/8080/8081 и прозрачный режим); трафик напрямую в обход Xray не фильтруется.
CONF=/etc/pw2-routing.conf
[ -f "$CONF" ] || { echo "нет $CONF (сначала pw2-setup)"; exit 1; }
get() { sed -n "s/^$1=\"\(.*\)\".*/\1/p" "$CONF" | head -1; }
set_ads() {
  if grep -q '^ADS_BLOCK=' "$CONF"; then sed -i "s/^ADS_BLOCK=.*/ADS_BLOCK=$1/" "$CONF"; else echo "ADS_BLOCK=$1" >> "$CONF"; fi
  /usr/bin/pw2-routing-apply 2>&1 | sed -n 1,2p
}
case "$1" in
  status|"")
    a=$(sed -n 's/^ADS_BLOCK=\([01]\).*/\1/p' "$CONF" | head -1); a=${a:-1}
    echo "блокировка рекламы: $([ "$a" = 1 ] && echo ВКЛ || echo ВЫКЛ)"
    echo "список geosite: $(get ADS_GEOSITE)"
    echo "свои домены ($(get ADS_DOMAINS | wc -w)): $(get ADS_DOMAINS)"
    echo "правило в PassWall2: $(uci -q get passwall2.shunt_pool.rule_ads || echo нет)" ;;
  on)  set_ads 1 ;;
  off) set_ads 0 ;;
  allow) [ -n "$2" ] || { echo "укажите домен"; exit 1; }
    new=$(get ADS_DOMAINS | tr ' ' '\n' | grep -vxF "$2" | tr '\n' ' ' | sed 's/ $//')
    sed -i "s|^ADS_DOMAINS=.*|ADS_DOMAINS=\"$new\"|" "$CONF"; /usr/bin/pw2-routing-apply 2>&1 | sed -n 1,2p ;;
  update)
    # скачать свежие базы из релиза репозитория OpenWRT-VM-PROXY-ads (файлы geosite_ADS-*.dat и SHA256SUMS), проверить и подключить
    URL=$(get ADS_UPDATE_URL); URL=${URL:-https://github.com/quantum-fox/OpenWRT-VM-PROXY-ads/releases/latest/download}
    D=/usr/share/pw2/data; T=/tmp/pw2-ads-update; rm -rf $T; mkdir -p $T
    fetch() { curl -fsSL -m 180 -o "$T/$1" "$URL/$1" 2>/dev/null || curl -fsSL -m 240 -x http://127.0.0.1:8080 -o "$T/$1" "$URL/$1" 2>/dev/null; }   # сначала напрямую, затем через свой прокси 8080
    fetch SHA256SUMS || { echo "не удалось скачать $URL/SHA256SUMS (нет доступа к GitHub или релиз ещё не создан)"; rm -rf $T; exit 1; }
    for f in geosite_ADS-GLOBAL.dat geosite_ADS-RU.dat; do
      fetch $f || { echo "не удалось скачать $f"; rm -rf $T; exit 1; }
      want=$(grep " $f\$" $T/SHA256SUMS | cut -d' ' -f1); got=$(sha256sum $T/$f | cut -d' ' -f1)
      [ -n "$want" ] && [ "$want" = "$got" ] && [ "$(wc -c < $T/$f)" -gt 1000 ] || { echo "$f: контрольная сумма не совпала - файл не заменён"; rm -rf $T; exit 1; }
    done
    changed=0
    for f in geosite_ADS-GLOBAL.dat geosite_ADS-RU.dat; do cmp -s $T/$f $D/$f || { cp $T/$f $D/$f; changed=1; echo "обновлён $f ($(wc -c < $D/$f) байт)"; }; done
    rm -rf $T
    if [ $changed = 1 ]; then /usr/bin/pw2-geosite refresh; /usr/bin/pw2-routing-apply 2>&1 | sed -n 1,2p; echo "базы обновлены"; else echo "базы уже последней версии"; fi ;;
  *) echo "Использование: pw2-ads status|on|off|allow ДОМЕН|update"; exit 1 ;;
esac
