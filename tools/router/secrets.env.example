# СЕКРЕТЫ. Не публиковать, не пересылать, не добавлять в git. Формат: sh (. файл), значения в одинарных кавычках.
# Файл копируется на роутер (/root/secrets.env, права 600) командой pw2-setup или вручную на время работы скриптов.

# Подписка провайдера (токен в URL). Пусто = не использовать подписку (тогда пул состоит только из ваших серверов - не рекомендуется).
SUB_URL='https://example.com/PUT-YOUR-SUBSCRIPTION-URL-HERE'
SUB_SECTION='sub1'            # имя секции подписки в настройках роутера (латиница)
SUB_REMARK='subscription'     # имя группы узлов подписки

# Ваш сервер для РАБОЧЕГО выхода (порты 1081/8081). Ссылка vless:// из панели вашего сервера (3x-ui: клиент -> QR/ссылка).
# Для VLESS+Reality ссылка ОБЯЗАТЕЛЬНО должна содержать flow=xtls-rprx-vision, если сервер его требует (иначе соединение «открывается», но данные не идут).
LINK_WORK='vless://UUID@SERVER_IP:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=SITE&fp=chrome&pbk=PUBLIC_KEY&sid=SHORT_ID&type=tcp#work'

# Необязательно: ещё один ваш сервер, который войдёт в общий пул (остальной трафик). Имя - как узел будет называться на роутере.
LINK_EXTRA=''
EXTRA_NAME=''
